{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WebGuide AI TutorialVersion draft v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "tutorialId", "version", "title", "goal", "environment", "adapterId", "parameterProfile", "sources", "steps", "finalVerifierId"],
  "properties": {
    "schemaVersion": {"const": 1},
    "tutorialId": {"$ref": "#/$defs/id"},
    "version": {"type": "string", "minLength": 1, "maxLength": 64},
    "title": {"type": "string", "minLength": 1, "maxLength": 120},
    "goal": {"type": "string", "minLength": 1, "maxLength": 1000},
    "environment": {
      "type": "object", "additionalProperties": false,
      "required": ["browsers", "pageLanguages", "instructionLanguage"],
      "properties": {
        "browsers": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "pageLanguages": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "instructionLanguage": {"type": "string", "minLength": 1}
      }
    },
    "adapterId": {"$ref": "#/$defs/id"},
    "parameterProfile": {"$ref": "#/$defs/id"},
    "sources": {"type": "array", "minItems": 1, "maxItems": 30, "items": {"$ref": "#/$defs/source"}},
    "steps": {"type": "array", "minItems": 1, "maxItems": 100, "items": {"$ref": "#/$defs/step"}},
    "finalVerifierId": {"$ref": "#/$defs/id"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9._-]{0,79}$"},
    "source": {
      "type": "object", "additionalProperties": false, "required": ["id", "title", "url"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "title": {"type": "string", "minLength": 1, "maxLength": 200},
        "url": {"type": "string", "pattern": "^https://", "maxLength": 2048}
      }
    },
    "target": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["locatorId"],
          "properties": {"locatorId": {"$ref": "#/$defs/id"}}},
        {"type": "object", "additionalProperties": false, "required": ["css"],
          "properties": {"css": {"type": "string", "minLength": 1, "maxLength": 512},
            "textEquals": {"type": "string", "maxLength": 256}}}
      ]
    },
    "check": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["type", "checkerId"],
          "properties": {"type": {"const": "adapter"}, "checkerId": {"$ref": "#/$defs/id"}}},
        {"type": "object", "additionalProperties": false, "required": ["type", "assertion"],
          "properties": {"type": {"const": "dom"}, "assertion": {"enum": ["exists", "visible", "text-equals", "value-equals"]},
            "target": {"$ref": "#/$defs/target"},
            "expected": {"type": "string", "maxLength": 256}},
          "allOf": [{"if": {"properties": {"assertion": {"enum": ["text-equals", "value-equals"]}}}, "then": {"required": ["expected"]}, "else": {"not": {"required": ["expected"]}}}]}
      ]
    },
    "step": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "pageRole", "title", "instruction", "action", "target", "check", "sourceIds"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "pageRole": {"$ref": "#/$defs/id"},
        "title": {"type": "string", "minLength": 1, "maxLength": 120},
        "instruction": {"type": "string", "minLength": 1, "maxLength": 2000},
        "action": {"enum": ["select", "click", "inspect", "wait"]},
        "target": {"$ref": "#/$defs/target"}, "check": {"$ref": "#/$defs/check"},
        "sourceIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}
      }
    }
  }
}
