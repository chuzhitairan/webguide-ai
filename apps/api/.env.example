# 可选端口，留空配置文件中此项时使用默认 43130。需要覆盖时取消下一行注释并填写整数。
# WG_PORT=

# 模型只由本机服务调用。复制为 .env 后填写各项。
WG_MODEL_BASE_URL=https://agi.tongji.edu.cn/v1
WG_MODEL_NAME=DeepSeek-V4.1-Flash
WG_MODEL_API_KEY=

# 这是扩展访问本机服务的令牌，和模型密钥是两回事。
# 用 node -e "console.log(require('node:crypto').randomBytes(24).toString('hex'))" 生成。
WG_CLIENT_TOKEN=
# 从扩展侧栏的「本机服务设置」复制完整来源。
WG_ALLOWED_EXTENSION_ORIGINS=
