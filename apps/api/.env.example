# 默认端口为 43130。要改端口，可复制为 .env 并取消下一行的注释。
# WG_PORT=43130

# 模型只由本机服务调用。复制为 .env 后填写 HTTPS API 地址、模型名与密钥。
WG_MODEL_BASE_URL=
WG_MODEL_NAME=
WG_MODEL_API_KEY=
# 模型支持 reasoning_effort 时可选填。DeepSeek Flash 的实时导航可设为 none。
# WG_MODEL_REASONING_EFFORT=none

# 扩展访问本机服务的独立令牌，可用下列命令生成。
# node -e "console.log(require('node:crypto').randomBytes(24).toString('hex'))"
WG_CLIENT_TOKEN=

# 填写 chrome-extension://扩展ID，多个来源用英文逗号分隔。
# 留空时接受格式有效的 Chrome/Edge 扩展来源，仍需提供正确令牌。
WG_ALLOWED_EXTENSION_ORIGINS=
